PORT=3000
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=3306
DB_USER=hpm_fe
DB_PASS=
DB_NAME=hpm_fe

# Producción:
AFIP_URL=https://servicios1.afip.gov.ar/wsfev1/service.asmx
WSAA_URL=https://wsaa.afip.gov.ar/ws/services/LoginCms

# Homologación (testing) — descomentar para usar:
# AFIP_URL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx
# WSAA_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
P12_ENCRYPTION_KEY=

# Generar con: openssl rand -hex 32
ADMIN_SECRET=

# API Key única que usa HPM para autenticarse (header Authorization: Bearer ...).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HPM_API_KEY=

RATE_LIMIT_RPS=5

# Padron ARCA (GET /api/v1/padron/:cuit). CUIT de la empresa cargada en /admin cuyo
# certificado se usa para todas las consultas; tiene que estar autorizado en ARCA para
# ws_sr_padron_a13 (padron A13). PADRON_URL solo hace falta para homologacion.
PADRON_CUIT=20219547006
# PADRON_URL=https://awshomo.afip.gov.ar/sr-padron/webservices/personaServiceA13
