  "description": "API middleware para facturación electrónica AFIP/ARCA",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
